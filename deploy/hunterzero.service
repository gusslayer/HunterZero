[Unit]
Description=HunterZero GPi interface
# Espera a que existan las sesiones locales y evita arrancar sobre una consola gráfica activa.
After=systemd-user-sessions.service
Conflicts=getty@tty1.service

[Service]
Type=simple
User=@APP_USER@
# Sin SupplementaryGroups, systemd toma los grupos del usuario (input, video y
# render, gestionados por install.sh). El usuario nunca debe ejecutarse como root.
WorkingDirectory=@APP_DIR@
Environment=SDL_VIDEODRIVER=kmsdrm
Environment=HUNTERZERO_FULLSCREEN=1
Environment=PYTHONUNBUFFERED=1
ExecStart=@APP_DIR@/.venv/bin/python @APP_DIR@/main.py
Restart=on-failure
RestartSec=3
TTYPath=/dev/tty1
StandardInput=tty
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes

[Install]
WantedBy=multi-user.target
